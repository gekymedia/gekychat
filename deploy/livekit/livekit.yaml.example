# Copy to /opt/livekit/livekit.yaml on the VPS and fill keys from Laravel .env
# LIVEKIT_API_KEY / LIVEKIT_API_SECRET must match the keys: block below.

port: 7880
bind_addresses:
  - ""
log_level: info

rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 60000
  use_external_ip: true
  interfaces:
    includes:
      - eth0

redis:
  address: 127.0.0.1:6379

# Embedded TURN for mobile carrier / strict NAT
turn:
  enabled: true
  domain: live.gekychat.com
  udp_port: 3478
  tls_port: 5349
  cert_file: /etc/letsencrypt/live/live.gekychat.com/fullchain.pem
  key_file: /etc/letsencrypt/live/live.gekychat.com/privkey.pem

room:
  auto_create: true
  empty_timeout: 300
  departure_timeout: 20
  max_participants: 50

prometheus:
  port: 6789

keys:
  YOUR_API_KEY: YOUR_API_SECRET
